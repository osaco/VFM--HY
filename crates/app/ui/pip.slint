// Phase 3 picture-in-picture window. Keeps the same decoded frame buffer as PlayerWindow.
// No libVLC calls here; Rust mirrors the shared image onto both surfaces.

import { Theme } from "theme.slint";
import { Strings } from "strings.slint";

export component PipWindow inherits Window {
    width: 360px;
    height: 220px;
    no-frame: true;
    title: Strings.s_action_pip;
    icon: @image-url("../../../assets/branding/vfm-256.png");
    background: Theme.bg-base;
    // Same reason as PlayerWindow: the focus scope must be the window's forward target or
    // space / f / Escape never reach it.
    forward-focus: pip-keys;

    in-out property <image> video-frame;
    in-out property <string> filename;
    in-out property <float> seek-position: 0;
    in-out property <bool> playing: false;

    callback toggle-play();
    callback close-pip();
    callback toggle-fullscreen();

    pip-keys := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if (event.text == " " || event.text == "Space") { root.toggle-play(); return accept; }
            if (event.text == "f" || event.text == "F") { root.toggle-fullscreen(); return accept; }
            if (event.text == "Escape") { root.close-pip(); return accept; }
            reject
        }

        Rectangle {
            width: 100%; height: 100%;
            background: Theme.bg-video;
            Image {
                width: 100%; height: 100%;
                source: root.video-frame;
                image-fit: ImageFit.contain;
            }
        }

        WindowMoveArea {
            width: 100%; height: Theme.control-height-md;
            Rectangle {
                width: 100%; height: 100%;
                background: Theme.bg-overlay;
                HorizontalLayout {
                    padding-left: Theme.space-3;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-2;
                    Text {
                        text: root.filename;
                        color: Theme.text-body;
                        font-family: Theme.font;
                        font-size: Theme.text-2;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: Theme.control-height-sm; height: Theme.control-height-sm;
                        border-radius: Theme.radius-sm;
                        background: Theme.bg-surface;
                        Image {
                            width: Theme.icon-size-sm; height: Theme.icon-size-sm;
                            source: @image-url("../../../assets/icons/control/close.svg");
                        }
                        TouchArea { width: 100%; height: 100%; clicked => { root.close-pip(); } }
                    }
                }
            }
        }

        Rectangle {
            y: parent.height - Theme.focus-width;
            width: 100%; height: Theme.focus-width;
            background: Theme.border-default;
            Rectangle {
                width: root.seek-position * parent.width;
                height: 100%;
                background: Theme.accent;
            }
        }
    }
}
