// Generated by tools/generate_theme.py from design/tokens.md. Do not edit by hand.
// mode: 0 = dark (Figma source), 1 = light. `accent` is runtime-changeable.
export global Theme {
    in-out property <int> mode: 0;
    in-out property <color> accent: #D37918;
    in-out property <bool> rtl: false;

    // Color
    out property <color> bg-base: mode == 1 ? #F7F7F7 : #0E0E0E;
    out property <color> bg-surface: mode == 1 ? #FFFFFF : #181818;
    out property <color> bg-elevated: mode == 1 ? #FFFFFF : #1B1B1B;
    out property <color> bg-control: mode == 1 ? #EFEFEF : #090909;
    out property <color> bg-video: mode == 1 ? #D9D7D4 : #2D2B29;
    out property <color> bg-overlay: mode == 1 ? #FFFFFFD9 : #000000CC;
    out property <color> text-primary: mode == 1 ? #111111 : #FFFFFF;
    out property <color> text-body: mode == 1 ? #2B2B2B : #E0E0E0;
    out property <color> text-secondary: mode == 1 ? #666666 : #8F8F8F;
    out property <color> text-muted: mode == 1 ? #777777 : #CCCCCC;
    in-out property <color> text-on-accent: #0B0B0B;
    out property <color> danger: mode == 1 ? #C0392B : #AB261D;
    out property <color> border-subtle: mode == 1 ? #E0E0E0 : #2B2927;
    out property <color> border-default: mode == 1 ? #BDBDBD : #404040;
    out property <color> volume-fill: mode == 1 ? #5E7D0E : #7BA213;
    out property <color> accent-hover: accent.mix(#FFFFFF, 0.88);
    out property <color> accent-pressed: accent.mix(#000000, 0.88);
    out property <color> accent-soft: accent.mix(bg-surface, 0.14);
    out property <color> focus-ring: accent;

    // Typography
    out property <string> font-latin: "Inter";
    out property <string> font-arabic: "Noto Sans Arabic";
    out property <string> font: rtl ? font-arabic : font-latin;
    out property <length> text-1: 11px;
    out property <length> text-2: 12px;
    out property <length> text-3: 13px;
    out property <length> text-4: 14px;
    out property <length> text-5: 16px;
    out property <length> text-6: 20px;
    out property <length> text-7: 24px;
    out property <length> text-8: 32px;
    out property <float> line-height: 1.4;

    // Spacing (4px grid)
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 24px;
    out property <length> space-6: 32px;
    out property <length> space-7: 48px;

    // Radii
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;
    out property <length> radius-xl: 16px;
    out property <length> radius-pill: 9999px;

    // Component metrics
    out property <length> control-height-sm: 28px;
    out property <length> control-height-md: 36px;
    out property <length> control-height-lg: 44px;
    out property <length> icon-size-sm: 16px;
    out property <length> icon-size-md: 20px;
    out property <length> icon-size-lg: 28px;
    out property <length> border-width: 1px;
    out property <length> focus-width: 2px;
    out property <length> track-height: 4px;
    out property <length> seek-height: 28px;
    out property <length> seek-fill-height: 24px;
    out property <length> seek-thumb-width: 8px;
    out property <length> player-topbar-height: 40px;
    out property <length> player-bottombar-height: 54px;
    out property <length> player-icon-button: 42px;
    out property <length> player-play-width: 54px;
    out property <length> player-play-height: 28px;
    out property <length> volume-cone-width: 90px;
    out property <length> volume-cone-height: 16px;
    out property <length> menu-width: 220px;
    out property <length> menu-row-height: 40px;
    out property <length> dialog-width: 420px;
    out property <length> tooltip-width: 140px;
    out property <length> tab-min-width: 96px;
    out property <length> scrollbar-width: 8px;
    out property <length> thumbnail-width: 132px;
    out property <length> thumbnail-height: 74px;

    // Elevation
    out property <color> shadow-color: #00000066;
    out property <length> shadow-e1-blur: 2px;
    out property <length> shadow-e1-y: 1px;
    out property <length> shadow-e2-blur: 12px;
    out property <length> shadow-e2-y: 4px;
    out property <length> shadow-e3-blur: 32px;
    out property <length> shadow-e3-y: 12px;

    // Motion
    out property <duration> motion-fast: 120ms;
    out property <duration> motion-base: 200ms;
    out property <duration> motion-slow: 320ms;
}
