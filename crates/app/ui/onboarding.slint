// First-run onboarding (Phase 8): theme, accent and a handful of shortcuts, shown once.

import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { VfmButton } from "components.slint";

export component OnboardingWindow inherits Window {
    width: 640px;
    height: 660px;
    title: Strings.s_onboarding_title;
    icon: @image-url("../../../assets/branding/vfm-256.png");
    background: Theme.bg-base;

    in-out property <int> theme-index: 0;
    in-out property <int> accent-index: 0;
    in-out property <[color]> accents;
    in-out property <[string]> theme-labels;

    callback theme-picked(int);
    callback accent-picked(int);
    callback start();
    callback skip();

    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-4;

        Image {
            height: 56px;
            width: 56px;
            source: @image-url("../../../assets/branding/vfm-256.png");
            image-fit: contain;
        }
        Text {
            text: Strings.s_onboarding_title;
            color: Theme.text-primary;
            font-family: Theme.font;
            font-size: Theme.text-8;
            font-weight: 600;
            height: Theme.text-8 * Theme.line-height;
            horizontal-alignment: Theme.rtl ? right : left;
        }
        Text {
            text: Strings.s_onboarding_subtitle;
            color: Theme.text-secondary;
            font-family: Theme.font;
            font-size: Theme.text-4;
            height: Theme.text-4 * Theme.line-height;
            horizontal-alignment: Theme.rtl ? right : left;
        }

        // ---- theme ----
        Text {
            text: Strings.s_onboarding_theme;
            color: Theme.text-body;
            font-family: Theme.font;
            font-size: Theme.text-3;
            font-weight: 600;
            height: Theme.text-3 * Theme.line-height;
            horizontal-alignment: Theme.rtl ? right : left;
        }
        HorizontalLayout {
            height: 72px;
            spacing: Theme.space-3;
            for label[i] in root.theme-labels: Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.radius-lg;
                border-width: i == root.theme-index ? 2px : Theme.border-width;
                border-color: i == root.theme-index ? Theme.accent : Theme.border-default;
                // 0 = System, 1 = Dark, 2 = Light: each card previews the theme it selects.
                background: i == 1 ? #0E0E0E : (i == 2 ? #F7F7F7 : Theme.bg-surface);
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: label;
                        color: i == 1 ? #FFFFFF : (i == 2 ? #111111 : Theme.text-primary);
                        font-family: Theme.font;
                        font-size: Theme.text-3;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        height: 100%;
                    }
                }
                theme-touch := TouchArea {
                    width: 100%; height: 100%;
                    clicked => { root.theme-picked(i); }
                }
            }
        }

        // ---- accent ----
        Text {
            text: Strings.s_onboarding_accent;
            color: Theme.text-body;
            font-family: Theme.font;
            font-size: Theme.text-3;
            font-weight: 600;
            height: Theme.text-3 * Theme.line-height;
            horizontal-alignment: Theme.rtl ? right : left;
        }
        HorizontalLayout {
            height: 40px;
            spacing: Theme.space-2;
            for colour[i] in root.accents: Rectangle {
                width: 34px; height: 34px;
                border-radius: Theme.radius-pill;
                background: colour;
                border-width: i == root.accent-index ? 3px : 0px;
                border-color: Theme.text-primary;
                accent-touch := TouchArea {
                    width: 100%; height: 100%;
                    clicked => { root.accent-picked(i); }
                }
            }
        }

        // ---- shortcuts ----
        Text {
            text: Strings.s_onboarding_keys;
            color: Theme.text-body;
            font-family: Theme.font;
            font-size: Theme.text-3;
            font-weight: 600;
            height: Theme.text-3 * Theme.line-height;
            horizontal-alignment: Theme.rtl ? right : left;
        }
        Rectangle {
            min-height: 92px;
            vertical-stretch: 1;
            border-radius: Theme.radius-lg;
            background: Theme.bg-surface;
            border-width: Theme.border-width;
            border-color: Theme.border-subtle;
            Text {
                x: Theme.space-4;
                y: Theme.space-4;
                width: parent.width - Theme.space-4 * 2;
                height: max(parent.height - Theme.space-4 * 2, Theme.text-3 * Theme.line-height);
                text: Strings.s_onboarding_keys_body;
                color: Theme.text-body;
                font-family: Theme.font;
                font-size: Theme.text-3;
                wrap: word-wrap;
                vertical-alignment: top;
                horizontal-alignment: Theme.rtl ? right : left;
            }
        }

        HorizontalLayout {
            height: Theme.control-height-lg;
            spacing: Theme.space-2;
            alignment: Theme.rtl ? LayoutAlignment.start : LayoutAlignment.end;
            VfmButton {
                text: Strings.s_onboarding_skip;
                clicked => { root.skip(); }
            }
            VfmButton {
                text: Strings.s_onboarding_start;
                primary: true;
                clicked => { root.start(); }
            }
        }
    }
}
