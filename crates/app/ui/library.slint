// Phase 4 — Queue & Library views.
// LibraryWindow is a standalone full-screen view with a compact mini-player at the bottom.
// QueuePanel is embedded in the player as a right-side overlay.
// All strings come from Strings; all styling from Theme; RTL handled by mirroring helpers.

import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import {
    VfmIconButton, VfmButton, VfmSearchField, VfmBreadcrumb, VfmTabs,
    VfmListRow, VfmGridItem, VfmScrollBar, VfmDropdown, VfmTooltip, VfmSeekBar,
} from "components.slint";

// One row handed from Rust to Slint. Mirrors core::library::LibraryEntry.
export struct MediaRow {
    path: string,
    title: string,
    subtitle: string,
    kind: string,
    duration: string,
    size: string,
    progress: float,
    watched: bool,
    pinned: bool,
    has-thumbnail: bool,
    thumbnail: image,
}

export struct QueueRow {
    path: string,
    title: string,
    duration: string,
    playing: bool,
}

// ---------------------------------------------------------------------------
// QueuePanel — overlay panel shown from the player's queue button.
// ---------------------------------------------------------------------------
export component QueuePanel inherits Rectangle {
    in property <[QueueRow]> rows;
    in property <bool> show: false;
    in property <length> view-width: 1280px;
    in property <length> view-height: 720px;
    in-out property <int> current-index: -1;
    callback play-at(int);
    callback remove-at(int);
    callback move-row(int, int);
    callback clear();
    callback close();

    width: Theme.menu-width + 40px;
    height: root.view-height - Theme.player-topbar-height - Theme.player-bottombar-height;
    x: Theme.rtl ? 0px : root.view-width - self.width;
    y: Theme.player-topbar-height;
    z: 28;
    visible: root.show;
    border-radius: Theme.radius-lg;
    background: Theme.bg-elevated;
    border-width: Theme.border-width;
    border-color: Theme.border-default;

    VerticalLayout {
        spacing: Theme.space-1;
        padding: Theme.space-2;

        // Header
        Rectangle {
            height: Theme.control-height-md;
            HorizontalLayout {
                spacing: Theme.space-2;
                Text {
                    text: Strings.s_queue_title;
                    color: Theme.text-primary;
                    font-family: Theme.font;
                    font-size: Theme.text-5;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    horizontal-alignment: Theme.rtl ? right : left;
                }
                VfmTooltip {
                    text: Strings.s_queue_clear;
                    show: clear-touch.has-hover;
                    width: Theme.tooltip-width;
                }
                clear-touch := TouchArea {
                    width: Theme.control-height-sm; height: Theme.control-height-sm;
                    clicked => { root.clear(); }
                    Rectangle {
                        width: 100%; height: 100%;
                        border-radius: Theme.radius-sm;
                        background: clear-touch.has-hover ? Theme.bg-surface : transparent;
                        Text { text: "✕"; color: Theme.text-secondary; font-size: Theme.text-2; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                VfmIconButton {
                    size: Theme.control-height-sm; glyph-size: Theme.icon-size-sm;
                    icon: @image-url("../../../assets/icons/control/close.svg");
                    tooltip-text: Strings.s_action_close;
                    clicked => { root.close(); }
                }
            }
        }

        // Scrollable queue rows (virtualised by Rust: only the visible window is populated).
        Flickable {
            content-height: max(self.height, root.rows.length * Theme.control-height-lg);
            VerticalLayout {
                spacing: Theme.space-1;
                for row[i] in root.rows: Rectangle {
                    height: Theme.control-height-lg;
                    border-radius: Theme.radius-md;
                    background: row.playing ? Theme.accent-soft : (rowtouch.has-hover ? Theme.bg-surface : transparent);
                    border-width: row.playing ? Theme.focus-width : 0px;
                    border-color: Theme.accent;

                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-1;
                        spacing: Theme.space-2;
                        Rectangle {
                            width: Theme.icon-size-sm; height: Theme.icon-size-sm;
                            border-radius: Theme.radius-pill;
                            background: row.playing ? Theme.accent : Theme.text-secondary;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text {
                                text: row.title;
                                color: row.playing ? Theme.accent : Theme.text-primary;
                                font-family: Theme.font;
                                font-size: Theme.text-3;
                                overflow: elide;
                                horizontal-alignment: Theme.rtl ? right : left;
                            }
                            Text {
                                text: row.duration;
                                color: Theme.text-secondary;
                                font-family: Theme.font;
                                font-size: Theme.text-1;
                            }
                        }
                        VfmIconButton {
                            size: Theme.control-height-sm; glyph-size: Theme.icon-size-sm;
                            icon: @image-url("../../../assets/icons/control/close.svg");
                            tooltip-text: Strings.s_queue_remove;
                            clicked => { root.remove-at(i); }
                        }
                    }
                    rowtouch := TouchArea {
                        width: 100%; height: 100%;
                        clicked => { root.play-at(i); }
                    }
                }
            }
        }

        if root.rows.length == 0: Text {
            text: Strings.s_queue_empty;
            color: Theme.text-secondary;
            font-family: Theme.font;
            font-size: Theme.text-3;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// ---------------------------------------------------------------------------
// LibraryWindow — full-screen library with mini player.
// ---------------------------------------------------------------------------
export component LibraryWindow inherits Window {
    width: 1280px;
    height: 720px;
    title: Strings.s_library_title;
    icon: @image-url("../../../assets/branding/vfm-256.png");
    background: Theme.bg-base;

    in-out property <[MediaRow]> rows;
    in-out property <[string]> sidebar-items: [
        Strings.s_library_home, Strings.s_library_videos, Strings.s_library_music,
        Strings.s_library_network, Strings.s_library_playlists, Strings.s_library_recent,
        Strings.s_library_pinned, Strings.s_library_folders,
    ];
    in-out property <[string]> sort-options: [
        Strings.s_library_sort, Strings.s_library_recent, Strings.s_library_items_count,
    ];
    in-out property <string> section: "home";
    in-out property <string> breadcrumb: Strings.s_library_home;
    in-out property <string> search-text;
    in-out property <bool> scanning: false;
    in-out property <bool> show-network-form: false;
    in-out property <int> input-mode: 0; // 0 none, 1 folder, 2 file, 3 stream
    in-out property <string> network-url;
    in-out property <int> view-mode: 1; // 0 grid, 1 list, 2 detail
    in-out property <int> selected-index: -1;
    in-out property <int> sidebar-index: 0;

    // Mini player state
    in-out property <string> now-playing;
    in-out property <bool> playing: false;
    in-out property <float> seek-position: 0;
    in-out property <string> elapsed: "0:00";
    in-out property <string> duration: "0:00";

    callback open-row(int);
    callback add-to-queue(int);
    callback play-all();
    callback back();
    callback forward();
    callback sidebar-clicked(int);
    callback sort-changed(int);
    callback view-changed(int);
    callback search-changed(string);
    callback add-folder();
    callback add-file();
    callback submit-path(string);
    callback open-stream(string);
    callback toggle-play();
    callback seek-changed(float);
    callback open-player();
    callback close-library();
    callback pin-row(int);
    callback toggle-watched(int);
    // Dropping a file or folder anywhere on the library imports and plays it, so the default
    // screen (the library) accepts drops exactly like the player does.
    pure callback accepts-drop(data-transfer) -> bool;
    callback files-dropped(data-transfer);

    function mx(x: length, w: length) -> length {
        return Theme.rtl ? root.width - x - w : x;
    }

    // ---- drop target (whole window) ----
    DropArea {
        width: 100%; height: 100%;
        can-drop(event) => { root.accepts-drop(event.data) ? DragAction.copy : DragAction.none }
        dropped(event) => {
            root.files-dropped(event.data);
            return event.proposed-action;
        }
    }

    // ---- left sidebar ----
    Rectangle {
        x: 0; y: 0; width: Theme.menu-width; height: parent.height - Theme.control-height-lg;
        background: Theme.bg-surface;

        // right divider
        Rectangle {
            x: parent.width - Theme.border-width; y: 0;
            width: Theme.border-width; height: 100%;
            background: Theme.border-subtle;
        }

        VerticalLayout {
            padding: Theme.space-2;
            spacing: Theme.space-1;
            Text {
                text: Strings.s_library_title;
                color: Theme.text-primary;
                font-family: Theme.font;
                font-size: Theme.text-6;
                font-weight: 600;
                horizontal-alignment: Theme.rtl ? right : left;
                vertical-alignment: center;
                height: Theme.control-height-lg;
            }
            for item[i] in root.sidebar-items: Rectangle {
                height: Theme.control-height-md;
                border-radius: Theme.radius-md;
                background: i == root.sidebar-index ? Theme.accent-soft : (itemtouch.has-hover ? Theme.bg-elevated : transparent);
                HorizontalLayout {
                    padding-left: Theme.space-3;
                    spacing: Theme.space-2;
                    Text {
                        text: item;
                        color: i == root.sidebar-index ? Theme.accent : Theme.text-body;
                        font-family: Theme.font;
                        font-size: Theme.text-3;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        horizontal-alignment: Theme.rtl ? right : left;
                    }
                }
                itemtouch := TouchArea {
                    width: 100%; height: 100%;
                    clicked => { root.sidebar-index = i; root.sidebar-clicked(i); }
                }
            }
        }
    }

    // ---- main content ----
    Rectangle {
        x: Theme.menu-width; y: 0;
        width: parent.width - Theme.menu-width;
        height: parent.height - Theme.control-height-lg;
        background: Theme.bg-base;

        VerticalLayout {
            spacing: 0px;

            // Toolbar
            Rectangle {
                height: Theme.control-height-lg + Theme.space-2;
                HorizontalLayout {
                    padding-left: Theme.space-3;
                    padding-right: Theme.space-3;
                    spacing: Theme.space-2;
                    VfmIconButton {
                        size: Theme.control-height-sm; glyph-size: Theme.icon-size-sm;
                        icon: Theme.rtl ? @image-url("../../../assets/icons/control/chevron-right.svg") : @image-url("../../../assets/icons/control/chevron-left.svg");
                        tooltip-text: Strings.s_action_previous;
                        clicked => { root.back(); }
                    }
                    VfmIconButton {
                        size: Theme.control-height-sm; glyph-size: Theme.icon-size-sm;
                        icon: Theme.rtl ? @image-url("../../../assets/icons/control/chevron-left.svg") : @image-url("../../../assets/icons/control/chevron-right.svg");
                        tooltip-text: Strings.s_action_next;
                        clicked => { root.forward(); }
                    }
                    Text {
                        text: root.breadcrumb;
                        color: Theme.text-secondary;
                        font-family: Theme.font;
                        font-size: Theme.text-3;
                        vertical-alignment: center;
                        min-width: Theme.space-7;
                    }
                    VfmDropdown {
                        width: 160px;
                        options: root.sort-options;
                        selected(i) => { root.sort-changed(i); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VfmSearchField {
                        width: 220px;
                        placeholder: Strings.s_library_search_placeholder;
                        text <=> root.search-text;
                    }
                    VfmIconButton {
                        size: Theme.control-height-sm; glyph-size: Theme.icon-size-sm;
                        icon: @image-url("../../../assets/icons/control/grid.svg");
                        tooltip-text: Strings.s_library_view_grid;
                        active: root.view-mode == 0;
                        clicked => { root.view-changed(0); }
                    }
                    VfmIconButton {
                        size: Theme.control-height-sm; glyph-size: Theme.icon-size-sm;
                        icon: @image-url("../../../assets/icons/control/list.svg");
                        tooltip-text: Strings.s_library_view_list;
                        active: root.view-mode == 1;
                        clicked => { root.view-changed(1); }
                    }
                    VfmIconButton {
                        size: Theme.control-height-sm; glyph-size: Theme.icon-size-sm;
                        icon: @image-url("../../../assets/icons/control/info.svg");
                        tooltip-text: Strings.s_library_view_detail;
                        active: root.view-mode == 2;
                        clicked => { root.view-changed(2); }
                    }
                    VfmIconButton {
                        size: Theme.control-height-sm; glyph-size: Theme.icon-size-sm;
                        icon: @image-url("../../../assets/icons/control/browse.svg");
                        tooltip-text: Strings.s_library_add_folder;
                        clicked => { root.add-folder(); }
                    }
                    VfmIconButton {
                        size: Theme.control-height-sm; glyph-size: Theme.icon-size-sm;
                        icon: @image-url("../../../assets/icons/control/add.svg");
                        tooltip-text: Strings.s_library_add_file;
                        clicked => { root.add-file(); }
                    }
                }
            }

            // Network stream form
            if root.show-network-form: Rectangle {
                height: Theme.control-height-lg;
                background: Theme.bg-surface;
                HorizontalLayout {
                    padding-left: Theme.space-3;
                    padding-right: Theme.space-3;
                    spacing: Theme.space-2;
                    VfmSearchField {
                        width: 320px;
                        placeholder: root.input-mode == 1 ? Strings.s_library_add_folder
                            : (root.input-mode == 2 ? Strings.s_library_add_file : Strings.s_library_network_url);
                        text <=> root.network-url;
                    }
                    VfmButton {
                        text: Strings.s_library_open_stream;
                        primary: true;
                        clicked => { root.submit-path(root.network-url); }
                    }
                }
            }

            // Scanning indicator
            if root.scanning: Rectangle {
                height: Theme.control-height-sm;
                Text {
                    text: Strings.s_library_scanning;
                    color: Theme.accent;
                    font-family: Theme.font;
                    font-size: Theme.text-2;
                    horizontal-alignment: Theme.rtl ? right : left;
                    vertical-alignment: center;
                }
            }

            // Content area: list / grid / detail
            Flickable {
                vertical-stretch: 1;
                content-height: max(self.height, root.rows.length * (
                    root.view-mode == 0 ? Theme.thumbnail-height + Theme.space-7 : Theme.control-height-lg + Theme.space-1
                ));

                if root.view-mode == 0: GridLayout {
                    padding: Theme.space-3;
                    spacing: Theme.space-3;
                    for row[i] in root.rows: VfmGridItem {
                        thumbnail: row.thumbnail;
                        title: row.title;
                        progress: row.progress;
                        selected: i == root.selected-index;
                        clicked => { root.selected-index = i; }
                        TouchArea {
                            width: 100%; height: 100%;
                            double-clicked => { root.open-row(i); }
                        }
                    }
                }

                if root.view-mode == 1 || root.view-mode == 2: VerticalLayout {
                    padding: Theme.space-2;
                    spacing: Theme.space-1;
                    for row[i] in root.rows: Rectangle {
                        height: Theme.control-height-lg;
                        border-radius: Theme.radius-md;
                        background: i == root.selected-index ? Theme.accent-soft : (rowhover.has-hover ? Theme.bg-surface : transparent);
                        HorizontalLayout {
                            padding-left: Theme.space-2;
                            padding-right: Theme.space-2;
                            spacing: Theme.space-3;
                            Rectangle {
                                width: Theme.icon-size-md; height: Theme.icon-size-md;
                                Image {
                                    width: 100%; height: 100%;
                                    source: row.kind == "music"
                                        ? @image-url("../../../assets/icons/control/music.svg")
                                        : @image-url("../../../assets/icons/control/videos.svg");
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: row.title;
                                    color: Theme.text-primary;
                                    font-family: Theme.font;
                                    font-size: Theme.text-3;
                                    overflow: elide;
                                    horizontal-alignment: Theme.rtl ? right : left;
                                }
                                if root.view-mode == 2: Text {
                                    text: row.subtitle;
                                    color: Theme.text-secondary;
                                    font-family: Theme.font;
                                    font-size: Theme.text-1;
                                    overflow: elide;
                                }
                            }
                            Text {
                                text: row.duration;
                                color: Theme.text-secondary;
                                font-family: Theme.font;
                                font-size: Theme.text-2;
                                vertical-alignment: center;
                            }
                            VfmIconButton {
                                size: Theme.control-height-sm; glyph-size: Theme.icon-size-sm;
                                icon: @image-url("../../../assets/icons/control/queue.svg");
                                tooltip-text: Strings.s_queue_add_to;
                                clicked => { root.add-to-queue(i); }
                            }
                            VfmIconButton {
                                size: Theme.control-height-sm; glyph-size: Theme.icon-size-sm;
                                icon: row.pinned ? @image-url("../../../assets/icons/control/check.svg") : @image-url("../../../assets/icons/control/more.svg");
                                tooltip-text: Strings.s_library_pinned;
                                clicked => { root.pin-row(i); }
                            }
                        }
                        rowhover := TouchArea {
                            width: 100%; height: 100%;
                            clicked => { root.selected-index = i; }
                            double-clicked => { root.open-row(i); }
                        }
                    }
                }

                if root.rows.length == 0 && !root.scanning: Rectangle {
                    height: 120px;
                    Text {
                        text: Strings.s_library_empty;
                        color: Theme.text-secondary;
                        font-family: Theme.font;
                        font-size: Theme.text-4;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // ---- mini player strip ----
    Rectangle {
        x: 0; y: parent.height - Theme.control-height-lg;
        width: 100%; height: Theme.control-height-lg;
        background: Theme.bg-elevated;

        Rectangle {
            x: 0; y: 0; width: 100%; height: Theme.border-width;
            background: Theme.border-subtle;
        }

        HorizontalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-3;
            spacing: Theme.space-3;
            VfmIconButton {
                size: Theme.control-height-sm; glyph-size: Theme.icon-size-sm;
                icon: root.playing
                    ? @image-url("../../../assets/icons/control/pause.svg")
                    : @image-url("../../../assets/icons/control/play.svg");
                tooltip-text: Strings.s_action_play;
                clicked => { root.toggle-play(); }
            }
            Text {
                text: root.now-playing;
                color: Theme.text-body;
                font-family: Theme.font;
                font-size: Theme.text-2;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Text { text: root.elapsed; color: Theme.text-secondary; font-family: Theme.font; font-size: Theme.text-2; vertical-alignment: center; }
            VfmSeekBar {
                width: 240px;
                position: root.seek-position;
                seek-changed(p) => { root.seek-changed(p); }
            }
            Text { text: root.duration; color: Theme.text-secondary; font-family: Theme.font; font-size: Theme.text-2; vertical-alignment: center; }
            VfmIconButton {
                size: Theme.control-height-sm; glyph-size: Theme.icon-size-sm;
                icon: @image-url("../../../assets/icons/control/fullscreen.svg");
                tooltip-text: Strings.s_action_fullscreen;
                clicked => { root.open-player(); }
            }
            VfmIconButton {
                size: Theme.control-height-sm; glyph-size: Theme.icon-size-sm;
                icon: @image-url("../../../assets/icons/control/close.svg");
                tooltip-text: Strings.s_action_close;
                clicked => { root.close-library(); }
            }
        }
    }
}
